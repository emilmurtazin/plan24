# Переменные для «Переменных» приложения в панели App Platform (Timeweb). Файлом в репозиторий НЕ класть.
# Обязательные:
PLAN24_SECRET=                         # openssl rand -hex 32
PLAN24_BASE_URL=https://plan.example.com
# Приложение — роль plan24_app (создаётся deploy/postgres/init-roles-managed.sql). Хост — ПРИВАТНЫЙ IP кластера:
PLAN24_DB_URL=postgresql+psycopg://plan24_app:ПАРОЛЬ@10.0.0.5:5432/default_db?sslmode=require
# Миграции — владелец БД (gen_user); получает только сервис migrate:
PLAN24_DB_MIGRATE_URL=postgresql+psycopg://gen_user:ПАРОЛЬ@10.0.0.5:5432/default_db?sslmode=require
# Необязательные:
PLAN24_WORKERS=2
PLAN24_DB_POOL=5
PLAN24_DB_OVERFLOW=5
PLAN24_SMTP_HOST=
PLAN24_SMTP_PORT=587
PLAN24_SMTP_USER=
PLAN24_SMTP_PASSWORD=
PLAN24_SMTP_SECURITY=starttls
PLAN24_MAIL_FROM=Plan 24 <noreply@example.com>
PLAN24_TG_MODE=off                     # off | poll | webhook
PLAN24_TG_TOKEN=
PLAN24_TG_SECRET=
PLAN24_TG_BOT_USERNAME=
PLAN24_TG_API_BASE=https://api.telegram.org   # через релей: https://72.56.68.43:9443 (см. deploy/relay/README.md)
PLAN24_TG_CA_PEM=                      # сертификат релея в base64 (его печатает setup-relay.sh)
PLAN24_TG_PROXY=
