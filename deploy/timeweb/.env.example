# Скопируйте в .env (chmod 600) и заполните. Секреты: openssl rand -hex 32
PLAN24_DOMAIN=plan.example.com
PLAN24_BASE_URL=https://plan.example.com
PLAN24_SECRET=

# --- БД (Timeweb Cloud, управляемый PostgreSQL). Лучше подключаться по ПРИВАТНОМУ IP внутри одной сети (VPC) ---
# Приложение — отдельной ролью plan24_app (создаётся deploy/postgres/init-roles-managed.sql):
PLAN24_DB_URL=postgresql+psycopg://plan24_app:ПАРОЛЬ_ПРИЛОЖЕНИЯ@10.0.0.5:5432/default_db?sslmode=require
# Миграции — владельцем БД (в Timeweb gen_user); используются только командой migrate:
PLAN24_DB_MIGRATE_URL=postgresql+psycopg://gen_user:ПАРОЛЬ_GEN_USER@10.0.0.5:5432/default_db?sslmode=require
# Если подключаетесь по домену кластера с проверкой сертификата: положите сертификат из панели в ./certs/ и укажите
#   ...?sslmode=verify-full&sslrootcert=/certs/ca.crt
PLAN24_DB_POOL=5
PLAN24_DB_OVERFLOW=5
PLAN24_WORKERS=2

# --- Письма (SMTP почтового сервиса/провайдера) ---
PLAN24_SMTP_HOST=
PLAN24_SMTP_PORT=587
PLAN24_SMTP_USER=
PLAN24_SMTP_PASSWORD=
PLAN24_SMTP_SECURITY=starttls
PLAN24_MAIL_FROM=Plan 24 <noreply@example.com>

# --- Telegram (необязательно; с российских серверов api.telegram.org может быть недоступен — см. README, раздел Telegram) ---
PLAN24_TG_TOKEN=
PLAN24_TG_SECRET=
PLAN24_TG_BOT_USERNAME=
# релей за пределами РФ или прокси (если прямой доступ закрыт):
# PLAN24_TG_API_BASE=https://relay.example.com
# PLAN24_TG_PROXY=socks5://user:pass@host:1080
