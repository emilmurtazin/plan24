# Скопируйте в .env и заполните. Секреты генерируйте:  openssl rand -hex 32
POSTGRES_PASSWORD=
PLAN24_OWNER_PASSWORD=
PLAN24_APP_PASSWORD=
PLAN24_ADMIN_PASSWORD=

PLAN24_SECRET=                       # подпись токенов, обязателен в prod
PLAN24_BASE_URL=https://plan.example.com
PLAN24_WORKERS=2

# Письма (без SMTP письма не отправляются)
PLAN24_SMTP_HOST=
PLAN24_SMTP_PORT=587
PLAN24_SMTP_USER=
PLAN24_SMTP_PASSWORD=
PLAN24_SMTP_SECURITY=starttls
PLAN24_MAIL_FROM=Plan 24 <noreply@example.com>

# Telegram-бот (необязательно)
PLAN24_TG_TOKEN=
PLAN24_TG_SECRET=
PLAN24_TG_BOT_USERNAME=

# Подключения к БД: pool × воркеры не должен превышать max_connections PostgreSQL
PLAN24_DB_POOL=10
PLAN24_DB_OVERFLOW=10
