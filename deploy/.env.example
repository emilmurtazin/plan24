# Скопируйте в .env и заполните. Секреты генерируйте:  openssl rand -hex 32
POSTGRES_PASSWORD=
PLAN24_OWNER_PASSWORD=
PLAN24_APP_PASSWORD=
PLAN24_ADMIN_PASSWORD=

PLAN24_SECRET=                       # подпись токенов, обязателен в prod
PLAN24_BASE_URL=https://plan.example.com
PLAN24_WORKERS=2

# Панель суперадмина (/admin). Пусто — панели нет, адрес отвечает 404.
# Хеш пароля: см. docs/OPERATIONS.md, «Панель суперадмина» (python -m plan24.superadmin_tool); в .env знак $ удваивается: $$
PLAN24_SUPERADMIN_EMAIL=
PLAN24_SUPERADMIN_PASSWORD_HASH=
# Счётчик Яндекс.Метрики лендинга /welcome (только цифры; пусто — без аналитики)
PLAN24_METRIKA_ID=

# Письма (без SMTP письма не отправляются)
PLAN24_SMTP_HOST=
PLAN24_SMTP_PORT=587
PLAN24_SMTP_USER=
PLAN24_SMTP_PASSWORD=
PLAN24_SMTP_SECURITY=starttls
PLAN24_MAIL_FROM=Plan 24 <noreply@example.com>

# Telegram-бот (необязательно)
PLAN24_TG_TOKEN=
PLAN24_TG_SECRET=
PLAN24_TG_BOT_USERNAME=
# Telegram через релей за пределами РФ (deploy/relay/README.md): адрес релея и его сертификат (base64)
# PLAN24_TG_API_BASE=https://72.56.68.43:9443
# PLAN24_TG_CA_PEM=

# Подключения к БД: pool × воркеры не должен превышать max_connections PostgreSQL
PLAN24_DB_POOL=10
PLAN24_DB_OVERFLOW=10
# Мини-приложение Telegram: нужен HTTPS-адрес сервиса в PLAN24_BASE_URL (Telegram не открывает http). Выключить: PLAN24_TGAPP=off
# PLAN24_TGAPP=on
